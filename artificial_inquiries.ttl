    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:pageVademecum a rdf:Property ;
    rdfs:label "page du vademecum" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:fichier a rdf:Property ;
    rdfs:label "fichier" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:typeMime a rdf:Property ;
    rdfs:label "type MIME" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasReflexion a rdf:Property ;
    rdfs:label "a comme réflexion" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasObservation a rdf:Property ;
    rdfs:label "a comme observation" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasDimension a rdf:Property ;
    rdfs:label "a comme dimension" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasExemple a rdf:Property ;
    rdfs:label "a comme exemple" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasExercice a rdf:Property ;
    rdfs:label "a comme exercice" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:hasMedia a rdf:Property ;
